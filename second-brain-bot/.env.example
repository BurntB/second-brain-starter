# Who the bot is for. Shows up in briefing/digest prompts.
USER_NAME=Your Name
USER_ROLE=your role (e.g., "founder of Acme", "ops lead at Example Co")

# Telegram — from @BotFather (/newbot) and @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic — only needed if you run briefing.js directly without MCP
ANTHROPIC_API_KEY=

# Notion — create an internal integration at https://www.notion.so/profile/integrations
# and share the Second Brain page with it. DB IDs are the data_source_id values
# returned when you create each DB via Notion MCP (Step 1 of SETUP-AGENT-PROMPT.md).
NOTION_API_KEY=
NOTION_PEOPLE_DB=replace-with-your-people-data-source-id
NOTION_COMMITMENTS_DB=replace-with-your-commitments-data-source-id
NOTION_CONTEXT_DB=replace-with-your-context-data-source-id

# Override for memory-sync. Defaults to Claude Code's auto-derived slug
# (e.g. /Users/jane/.claude/projects/-Users-jane/memory). Only set this if
# your Claude Code memory lives somewhere non-default.
# CLAUDE_MEMORY_DIR=/absolute/path/to/your/claude-memory-dir

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
